<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Galaxy Buds Manager</string>
  <key>CFBundleIdentifier</key>
  <string>$(ApplicationId)</string>
  <key>CFBundleVersion</key>
  <string>$(ApplicationVersion)</string>
  <key>CFBundleShortVersionString</key>
  <string>$(ApplicationDisplayVersion)</string>
  <key>UILaunchStoryboardName</key>
  <string></string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Galaxy Buds Manager uses Bluetooth to discover and communicate with your Galaxy Buds.</string>
</dict>
</plist>
